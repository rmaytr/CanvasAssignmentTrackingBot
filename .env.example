# Canvas Assignment Tracker Bot — copy to .env and fill in.
# Secrets go in files (see compose.yaml), never in this file.

DATA_MODE=api
CANVAS_BASE_URL=https://canvas.yourschool.edu
CANVAS_TOKEN_FILE=/run/secrets/canvas_token
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
# TELEGRAM_OWNER_ID=        # optional; otherwise pair with /start <code>
TIMEZONE=America/New_York

DIGEST_TIME=08:00
DIGEST_GRACE_UNTIL=12:00
DIGEST_LOOKAHEAD_DAYS=14
REMINDER_WINDOW_HOURS=24
REMINDER_INTERVAL_MINUTES=120
QUIET_HOURS=00:00-08:00
OVERDUE_REMINDERS=false
OVERDUE_REMINDER_MAX_HOURS=48
HIDE_COURSES=

DB_PATH=/data/bot.db
ITEM_RETENTION_DAYS=30
LOG_LEVEL=INFO
