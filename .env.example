# Canvas Assignment Tracker Bot (friends mode). Copy to .env; deploy/install.sh does this.
# Secrets go in files under secrets/ (see compose.yaml), never in this file.
# Each person's Canvas address, token (or calendar feed link), time zone, morning time and
# quiet hours are set in the Telegram chat, not here.

# Your own Telegram user ID makes you the owner straight away. Leave it empty to
# claim the bot with the one-time pairing code from the log instead.
OWNER_TELEGRAM_ID=

# How many people can sign up (you included). Sign-ups left unfinished for 7 days are
# cleared automatically and stop counting.
MAX_USERS=25

# Reminder rules. The first three are the defaults: each person can pick their own in
# /settings → ⏰ Reminders (morning list 7/14/21 days, start reminding 12/24/48 h before,
# reminders every 1-4 h or no repeats). People who never change them follow these.
DIGEST_LOOKAHEAD_DAYS=14
REMINDER_WINDOW_HOURS=24
REMINDER_INTERVAL_MINUTES=120
OVERDUE_REMINDERS=false
OVERDUE_REMINDER_MAX_HOURS=48

ITEM_RETENTION_DAYS=30

# Optional email: the morning list and a heads-up 2 hours before each deadline, for
# people who turn it on with /email in the chat. Leave SMTP_HOST empty for no email.
# Put the SMTP password (or API key) in secrets/smtp_password.txt, never here.
# Brevo: smtp-relay.brevo.com, port 587, SMTP_USERNAME = the SMTP login from
#   Brevo → SMTP & API → SMTP (like 8a1b2c001@smtp-brevo.com), not your own address.
# EMAIL_FROM must be exactly a sender verified in your provider (Brevo → Senders).
# Gmail: smtp.gmail.com, port 587, the Gmail address as SMTP_USERNAME (app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
EMAIL_FROM=
EMAIL_FROM_NAME=Canvas Tracker
LOG_LEVEL=INFO
